+
+/// A stock function at a fixed address, called with the C calling convention.
+macro_rules! stock {
+    ($addr:expr, fn($($t:ty),*) -> $r:ty) => {
+        unsafe { core::mem::transmute::<usize, extern "C" fn($($t),*) -> $r>($addr as usize) }
+    };
+}
+
