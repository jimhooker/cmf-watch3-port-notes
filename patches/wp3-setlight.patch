+// Stock addresses of the Watch 3 Pro (jx402_08 1.0.1.77) that the app-list entry and the set timer call.
+// Thumb functions unless noted. Each was seen working in the emulator; none was run on a watch.
+pub const UI_MEM_ALIGNED_ALLOC: u32 = 0x1019C389; // (pool, align, size, name)
+pub const UI_MEM_FREE: u32 = 0x1019C445; // (pool, ptr)
+pub const PSRAM_CACHE_FLUSH_INVALIDATE: u32 = 0x101DC72F;
+pub const VIBRATE: u32 = 0x100DA77D; // (strength, effect): 0 = 200 ms, 1 = 400 ms, 2 = 700 ms
+pub const UTC_SECONDS: u32 = 0x100B3CCD;
+pub const WAKE_LOCK: u32 = 0x101D0DE1; // (id)
+pub const WAKE_UNLOCK: u32 = 0x100B4C45;
+pub const FONT_OPEN: u32 = 0x100D9151; // (lv_font_t *, path) -> 0
+pub const FONT_CLOSE: u32 = 0x101997F5;
+pub const FONT_36M: u32 = 0x10238A24; // "/NAND:A/font36M.font", data
+pub const FONT_NM120: u32 = 0x1023BEAB; // "/NAND:A/nm120NB.font", data
+pub const LV_FONT_DEFAULT: u32 = 0x102304B8; // data
+pub const TIMER_LIST: u32 = 0x38044C54; // RAM: LVGL's timer list {node size 0x18, head, tail}; next at node + 0x1C
+
+pub const SCR_ACT: u32 = 0x101366DD;
+pub const OBJ_CREATE: u32 = 0x10138B49;
+pub const OBJ_GET_CHILD: u32 = 0x101E66BB;
+pub const OBJ_GET_CHILD_CNT: u32 = 0x101E66D9;
+pub const OBJ_SET_POS: u32 = 0x101E4DB1;
+pub const OBJ_SET_SIZE: u32 = 0x101E4E23;
+pub const OBJ_ALIGN: u32 = 0x101E4E85;
+pub const OBJ_ALIGN_TO: u32 = 0x10139C45;
+pub const OBJ_INVALIDATE: u32 = 0x101E52A9; // (obj)
+pub const OBJ_ADD_FLAG: u32 = 0x101E4367;
+pub const OBJ_CLEAR_FLAG: u32 = 0x101E428D;
+pub const OBJ_ADD_EVENT_CB: u32 = 0x10136AA1;
+pub const OBJ_ADD_STYLE: u32 = 0x1013AA71;
+pub const OBJ_SET_LOCAL_STYLE_PROP: u32 = 0x101E609D; // (obj, prop, value, selector)
+pub const EVENT_SEND: u32 = 0x10136A3D;
+pub const EVENT_GET_USER_DATA: u32 = 0x101E37D3;
+pub const IMG_CREATE: u32 = 0x10041959;
+pub const IMG_SET_SRC: u32 = 0x101C675D;
+pub const IMG_SET_PIVOT: u32 = 0x101C67A7;
+pub const LABEL_CREATE: u32 = 0x1014BB49;
+pub const LABEL_SET_TEXT: u32 = 0x1014C3D1;
+pub const LABEL_SET_LONG_MODE: u32 = 0x1014C611;
+pub const LABEL_SET_STRING_DSC: u32 = 0x1014C5D1;
+pub const LABEL_SCROLL_SETUP: u32 = 0x101ECE0B;
+pub const TIMER_CREATE: u32 = 0x10148E6D; // (cb, period ms, user data)
+pub const TIMER_DEL: u32 = 0x10148F05;
+
+// the app list (applist.rs)
+pub const LIST_UPDATE: u32 = 0x10047351;
+pub const GRID_UPDATE: u32 = 0x10046D99;
+pub const GRID_PLACE: u32 = 0x101C70EB;
+
+pub const RES: u32 = 2; // the UI memory pool the stock icons come from
+pub const SHORT_CLICKED: u32 = 4;
+pub const SCROLL: u32 = 11;
+pub const DELETE: u32 = 33;
+pub const FLAG_HIDDEN: u32 = 1;
+pub const FLAG_CLICKABLE: u32 = 2;
+pub const FLAG_EVENT_BUBBLE: u32 = 0x4000;
+pub const STATE_PRESSED: u32 = 0x20;
+pub const STYLE_RADIUS: u32 = 0x0B;
+pub const STYLE_BG_COLOR: u32 = 0x20;
+pub const STYLE_BG_OPA: u32 = 0x21;
+pub const STYLE_TEXT_COLOR: u32 = 0x55;
+pub const STYLE_TEXT_FONT: u32 = 0x57;
+pub const STYLE_TEXT_ALIGN: u32 = 0x5B;
+pub const TEXT_ALIGN_CENTER: u32 = 2;
