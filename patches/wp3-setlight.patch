diff --git a/fw/wp2-core/src/setlight.rs b/fw/wp2-core/src/setlight.rs
new file mode 100644
index 0000000..a2aaa45
--- /dev/null
+++ b/fw/wp2-core/src/setlight.rs
@@ -0,0 +1,183 @@
+//! Set Light, a stand-up set timer: one buzz says wrap up, a burst of three says get off. The timing and what the
+//! screen shows, kept apart from the stock calls so it runs in host tests (the stub's side is fw/wp3-stub).
+
+/// Set lengths in seconds; the first is a short one for trying the buzzes.
+pub const PRESETS: [u16; 6] = [30, 300, 420, 600, 900, 1200];
+pub const DEFAULT_PRESET: u8 = 1;
+/// The wrap-up buzz comes this long before the end, or halfway through a set that is no longer than this.
+pub const LIGHT: u32 = 60;
+/// A set left running stops by itself this long after the end.
+pub const OVER_LIMIT: u32 = 600;
+/// The get-off burst: this many buzzes, one every `BURST_TICKS` timer ticks.
+pub const BURST: u8 = 3;
+pub const BURST_TICKS: u8 = 3;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Phase {
+    Idle,
+    OnStage,
+    WrapUp,
+    OverTime,
+}
+
+/// Seconds into a set of `set` seconds at which the wrap-up buzz goes out.
+pub fn light_at(set: u32) -> u32 {
+    if set > LIGHT { set - LIGHT } else { set / 2 }
+}
+
+/// The phase and the seconds to show: the set length when idle, the time left while on stage, the time over after.
+pub fn shown(running: bool, elapsed: u32, set: u32) -> (Phase, u32) {
+    match (running, elapsed < set) {
+        (false, _) => (Phase::Idle, set),
+        (true, true) => (if elapsed >= light_at(set) { Phase::WrapUp } else { Phase::OnStage }, set - elapsed),
+        (true, false) => (Phase::OverTime, elapsed - set),
+    }
+}
+
+/// `m:ss` or `mm:ss` as a NUL-terminated string: the text starts at the returned offset of the buffer.
+pub fn clock(seconds: u32) -> ([u8; 6], usize) {
+    let (m, s) = (seconds / 60, seconds % 60);
+    let digit = |n: u32| b'0' + (n % 10) as u8;
+    ([digit(m / 10), digit(m), b':', digit(s / 10), digit(s), 0], (m < 10) as usize)
+}
+
+/// What one timer tick asks for.
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub struct Step {
+    /// the single wrap-up buzz
+    pub wrap_up: bool,
+    /// one buzz of the get-off burst
+    pub get_off: bool,
+    /// the set ran `OVER_LIMIT` past its end: stop it
+    pub stop: bool,
+}
+
+/// Which buzzes of a running set went out. `Cues::default()` starts a set.
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub struct Cues {
+    lit: bool,
+    ended: bool,
+    burst: u8,
+    wait: u8,
+}
+
+impl Cues {
+    /// Call once per timer tick with the seconds since the set started.
+    pub fn tick(&mut self, elapsed: u32, set: u32) -> Step {
+        let mut step = Step::default();
+        if !self.lit && elapsed >= light_at(set) {
+            (self.lit, step.wrap_up) = (true, true);
+        }
+        if !self.ended && elapsed >= set {
+            (self.ended, self.burst, self.wait) = (true, BURST, 0);
+        }
+        if self.burst > 0 {
+            if self.wait == 0 {
+                step.get_off = true;
+                (self.burst, self.wait) = (self.burst - 1, BURST_TICKS);
+            }
+            self.wait -= 1;
+        }
+        step.stop = elapsed >= set + OVER_LIMIT;
+        step
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn text(seconds: u32) -> String {
+        let (buf, at) = clock(seconds);
+        assert_eq!(buf[5], 0);
+        String::from_utf8(buf[at..5].to_vec()).unwrap()
+    }
+
+    #[test]
+    fn wrap_up_is_a_minute_before_the_end_or_halfway() {
+        assert_eq!(light_at(300), 240);
+        assert_eq!(light_at(1200), 1140);
+        assert_eq!(light_at(30), 15);
+        assert_eq!(light_at(60), 30);
+        assert_eq!(light_at(61), 1);
+    }
+
+    #[test]
+    fn presets_fit_the_clock_and_open_on_five_minutes() {
+        assert_eq!(PRESETS[DEFAULT_PRESET as usize], 300);
+        assert!(PRESETS.windows(2).all(|w| w[0] < w[1]));
+        assert!(PRESETS.iter().all(|&p| (p as u32 + OVER_LIMIT) < 100 * 60));
+    }
+
+    #[test]
+    fn clock_text() {
+        assert_eq!(text(0), "0:00");
+        assert_eq!(text(5), "0:05");
+        assert_eq!(text(30), "0:30");
+        assert_eq!(text(299), "4:59");
+        assert_eq!(text(300), "5:00");
+        assert_eq!(text(600), "10:00");
+        assert_eq!(text(1200), "20:00");
+        assert_eq!(text(1800 - 1), "29:59");
+    }
+
+    #[test]
+    fn screen_follows_the_set() {
+        assert_eq!(shown(false, 123, 300), (Phase::Idle, 300));
+        assert_eq!(shown(true, 0, 300), (Phase::OnStage, 300));
+        assert_eq!(shown(true, 239, 300), (Phase::OnStage, 61));
+        assert_eq!(shown(true, 240, 300), (Phase::WrapUp, 60));
+        assert_eq!(shown(true, 299, 300), (Phase::WrapUp, 1));
+        assert_eq!(shown(true, 300, 300), (Phase::OverTime, 0));
+        assert_eq!(shown(true, 312, 300), (Phase::OverTime, 12));
+        assert_eq!(shown(true, 14, 30), (Phase::OnStage, 16));
+        assert_eq!(shown(true, 15, 30), (Phase::WrapUp, 15));
+    }
+
+    /// Runs a set at four ticks a second and returns the tick numbers of each kind of buzz and of the stop.
+    fn run(set: u32, ticks: u32) -> (Vec<u32>, Vec<u32>, Option<u32>) {
+        let (mut cues, mut wrap, mut off, mut stop) = (Cues::default(), vec![], vec![], None);
+        for t in 0..ticks {
+            let step = cues.tick(t / 4, set);
+            if step.wrap_up {
+                wrap.push(t);
+            }
+            if step.get_off {
+                off.push(t);
+            }
+            if step.stop && stop.is_none() {
+                stop = Some(t);
+            }
+        }
+        (wrap, off, stop)
+    }
+
+    #[test]
+    fn one_buzz_to_wrap_up_then_three_to_get_off() {
+        let (wrap, off, stop) = run(300, 4 * 400);
+        assert_eq!(wrap, [4 * 240]);
+        assert_eq!(off, [4 * 300, 4 * 300 + 3, 4 * 300 + 6]);
+        assert_eq!(stop, None);
+        let (wrap, off, _) = run(30, 4 * 60);
+        assert_eq!(wrap, [4 * 15]);
+        assert_eq!(off, [4 * 30, 4 * 30 + 3, 4 * 30 + 6]);
+    }
+
+    #[test]
+    fn a_forgotten_set_stops_ten_minutes_over() {
+        let (_, off, stop) = run(30, 4 * 700);
+        assert_eq!(off.len(), 3);
+        assert_eq!(stop, Some(4 * (30 + OVER_LIMIT)));
+    }
+
+    #[test]
+    fn a_late_tick_still_gives_every_buzz_once() {
+        // the watch slept through both marks: the first tick after gives the wrap-up buzz and starts the burst
+        let mut cues = Cues::default();
+        assert_eq!(cues.tick(10, 300), Step::default());
+        assert_eq!(cues.tick(320, 300), Step { wrap_up: true, get_off: true, stop: false });
+        let later: Vec<Step> = (0..8).map(|_| cues.tick(321, 300)).collect();
+        assert_eq!(later.iter().filter(|s| s.get_off).count(), 2);
+        assert!(later.iter().all(|s| !s.wrap_up));
+    }
+}
