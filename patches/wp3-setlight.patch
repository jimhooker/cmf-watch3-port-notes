diff --git a/fw/wp3-stub/src/setlight.rs b/fw/wp3-stub/src/setlight.rs
new file mode 100644
index 0000000..9e5f726
--- /dev/null
+++ b/fw/wp3-stub/src/setlight.rs
@@ -0,0 +1,288 @@
+// Set Light: a stand-up set timer built into the stub. One buzz says wrap up, a burst of three says get off.
+//
+// The screen is a panel over the app list (a child of the list's screen, so it goes when the list is left); the
+// set itself keeps running in an LVGL timer. There are no writable statics: the state lives in a heap block that
+// the timer carries as its user data, and the app-list entry finds it again by walking LVGL's timer list.
+// LVGL timers stop in deep sleep, so a running set holds a wake lock. The timing itself is wp2-core setlight.rs.
+use crate::stock::*;
+use core::ptr::null_mut;
+use wp2_core::setlight::{clock, shown, Cues, Phase, DEFAULT_PRESET, PRESETS};
+
+const TICK_MS: u32 = 250; // the get-off buzzes are BURST_TICKS of these apart: 750 ms, 400 ms each
+// The display shows two frame buffers in turn, and a change drawn into only one of them flickers against the other
+// (seen on a real watch: the old seconds alternating with the new digit drawn over them). So after each change the
+// whole panel is invalidated again every REDRAW_MS for REDRAWS passes, which covers several consecutive refreshes
+// and so both buffers.
+const REDRAW_MS: u32 = 10;
+const REDRAWS: u8 = 20;
+const STRENGTH: u32 = 0x7F;
+const BUZZ_400: u32 = 1;
+const BUZZ_700: u32 = 2;
+/// No stock code takes this lock id: the view ids end at 0x117 and the fixed ones are 0x119, 0x136 and above.
+const LOCK_ID: u32 = 0x130;
+
+const BLACK: u32 = 0x0000;
+const WHITE: u32 = 0xFFFF;
+const GREY: u32 = 0x18C3;
+const PRESSED: u32 = 0x39E7;
+const AMBER: u32 = 0xFD20;
+const RED: u32 = 0xF8E3;
+const BUTTON: i32 = 84;
+
+type Obj = *mut u8;
+type Cb = extern "C" fn(*mut u8);
+
+#[repr(C)]
+struct State {
+    timer: *mut u8,
+    panel: Obj,
+    phase: Obj,
+    time: Obj,
+    minus: Obj,
+    plus: Obj,
+    go: Obj,    // the text on the start/stop button
+    start: u32, // UTC seconds
+    drawn: u32, // what the screen shows: phase << 16 | seconds
+    cues: Cues, // which buzzes of the running set went out
+    preset: u8,
+    running: bool,
+    small_open: bool,
+    big_open: bool,
+    redraws: u8,       // passes of `again` still to come
+    burst: *mut u8,    // the `again` timer while one runs
+    small: [u32; 8], // lv_font_t
+    big: [u32; 8],
+}
+
+/// The app-list entry was tapped.
+pub extern "C" fn open(_e: *mut u8) {
+    let s = find();
+    let s = if s.is_null() { create() } else { s };
+    if let Some(s) = unsafe { s.as_mut() }
+        && s.panel.is_null()
+    {
+        build(s);
+        draw(s);
+    }
+}
+
+fn find() -> *mut State {
+    let mut node = unsafe { *((TIMER_LIST + 4) as *const *const u32) };
+    while !node.is_null() {
+        if unsafe { *node.add(2) } == tick as *const () as usize as u32 {
+            return unsafe { *node.add(3) } as *mut State;
+        }
+        node = unsafe { *node.add(7) } as *const u32;
+    }
+    null_mut()
+}
+
+fn create() -> *mut State {
+    let alloc = stock!(UI_MEM_ALIGNED_ALLOC, fn(u32, u32, u32, *const u8) -> *mut u8);
+    let s = alloc(RES, 0x40, size_of::<State>() as u32, b"setlight\0".as_ptr()) as *mut State;
+    if s.is_null() {
+        return s;
+    }
+    let timer = stock!(TIMER_CREATE, fn(Cb, u32, *mut State) -> *mut u8)(tick, TICK_MS, s);
+    unsafe {
+        s.write_bytes(0, 1);
+        (*s).preset = DEFAULT_PRESET;
+        (*s).timer = timer;
+    }
+    s
+}
+
+extern "C" fn tick(timer: *mut u8) {
+    let s = unsafe { &mut **(timer.add(0xC) as *mut *mut State) };
+    if s.running {
+        let step = s.cues.tick(now().wrapping_sub(s.start), PRESETS[s.preset as usize] as u32);
+        if step.wrap_up {
+            buzz(BUZZ_700);
+        }
+        if step.get_off {
+            buzz(BUZZ_400);
+        }
+        if step.stop {
+            stop(s);
+        }
+    }
+    if !s.panel.is_null() {
+        draw(s);
+    } else if !s.running {
+        // nothing to show and nothing to time: the state goes with its timers
+        if !s.burst.is_null() {
+            stock!(TIMER_DEL, fn(*mut u8) -> ())(s.burst);
+        }
+        stock!(TIMER_DEL, fn(*mut u8) -> ())(s.timer);
+        stock!(UI_MEM_FREE, fn(u32, *mut State) -> ())(RES, s);
+    }
+}
+
+fn now() -> u32 {
+    stock!(UTC_SECONDS, fn() -> u32)()
+}
+
+fn buzz(effect: u32) {
+    stock!(VIBRATE, fn(u32, u32) -> i32)(STRENGTH, effect);
+}
+
+fn start(s: &mut State) {
+    (s.start, s.running, s.cues) = (now(), true, Cues::default());
+    stock!(WAKE_LOCK, fn(u32) -> ())(LOCK_ID);
+}
+
+fn stop(s: &mut State) {
+    s.running = false;
+    stock!(WAKE_UNLOCK, fn(u32) -> ())(LOCK_ID);
+}
+
+fn style(obj: Obj, prop: u32, value: u32, selector: u32) {
+    stock!(OBJ_SET_LOCAL_STYLE_PROP, fn(Obj, u32, u32, u32) -> ())(obj, prop, value, selector)
+}
+
+fn place(obj: Obj, x: i32, y: i32, w: i32, h: i32) -> Obj {
+    stock!(OBJ_SET_POS, fn(Obj, i32, i32) -> ())(obj, x, y);
+    stock!(OBJ_SET_SIZE, fn(Obj, i32, i32) -> ())(obj, w, h);
+    obj
+}
+
+fn panel(parent: Obj, x: i32, y: i32, w: i32, h: i32, colour: u32) -> Obj {
+    let o = place(stock!(OBJ_CREATE, fn(Obj) -> Obj)(parent), x, y, w, h);
+    style(o, STYLE_BG_COLOR, colour, 0);
+    style(o, STYLE_BG_OPA, 0xFF, 0);
+    o
+}
+
+/// A centred line of text, `w` wide.
+fn label(parent: Obj, y: i32, w: i32, h: i32) -> Obj {
+    let l = place(stock!(LABEL_CREATE, fn(Obj) -> Obj)(parent), 0, y, w, h);
+    style(l, STYLE_TEXT_ALIGN, TEXT_ALIGN_CENTER, 0);
+    l
+}
+
+fn set_text(label: Obj, text: &[u8]) {
+    stock!(LABEL_SET_TEXT, fn(Obj, *const u8) -> ())(label, text.as_ptr());
+}
+
+/// A round-ended button with one line of text; returns the button and its label.
+fn button(s: &mut State, x: i32, w: i32, line: i32, cb: Cb) -> (Obj, Obj) {
+    let b = panel(s.panel, x, 300, w, BUTTON, GREY);
+    style(b, STYLE_RADIUS, BUTTON as u32 / 2, 0);
+    style(b, STYLE_BG_COLOR, PRESSED, STATE_PRESSED);
+    stock!(OBJ_ADD_EVENT_CB, fn(Obj, Cb, u32, *mut State) -> *mut u8)(b, cb, SHORT_CLICKED, s);
+    (b, label(b, (BUTTON - line) / 2, w, line))
+}
+
+fn open_font(font: &mut [u32; 8], path: u32) -> bool {
+    stock!(FONT_OPEN, fn(*mut u32, u32) -> i32)(font.as_mut_ptr(), path) == 0
+}
+
+fn build(s: &mut State) {
+    let scr = stock!(SCR_ACT, fn(Obj) -> Obj)(null_mut());
+    s.panel = panel(scr, 0, 0, 466, 466, BLACK);
+    stock!(OBJ_ADD_EVENT_CB, fn(Obj, Cb, u32, *mut State) -> *mut u8)(s.panel, closed, DELETE, s);
+    s.small_open = open_font(&mut s.small, FONT_36M);
+    s.big_open = open_font(&mut s.big, FONT_NM120);
+    let small = if s.small_open { s.small.as_ptr() as u32 } else { LV_FONT_DEFAULT };
+    let big = if s.big_open { s.big.as_ptr() as u32 } else { small };
+    // an lv_font_t has its line height in the third word
+    let line = |font: u32| unsafe { *(font as *const i32).add(2) }.clamp(1, 200);
+    style(s.panel, STYLE_TEXT_FONT, small, 0);
+    style(s.panel, STYLE_TEXT_COLOR, WHITE, 0);
+    s.phase = label(s.panel, 64, 466, line(small));
+    s.time = label(s.panel, 210 - line(big) / 2, 466, line(big));
+    style(s.time, STYLE_TEXT_FONT, big, 0);
+    let (minus, text) = button(s, 58, BUTTON, line(small), shorter);
+    set_text(text, b"-\0");
+    s.minus = minus;
+    (_, s.go) = button(s, 163, 140, line(small), toggle);
+    let (plus, text) = button(s, 324, BUTTON, line(small), longer);
+    set_text(text, b"+\0");
+    s.plus = plus;
+    s.drawn = !0;
+}
+
+/// Brings the screen in line with the state; cheap when nothing changed.
+fn draw(s: &mut State) {
+    let (phase, seconds) = shown(s.running, now().wrapping_sub(s.start), PRESETS[s.preset as usize] as u32);
+    let was = s.drawn;
+    s.drawn = (phase as u32) << 16 | seconds;
+    if s.drawn == was {
+        return;
+    }
+    let (text, at) = clock(seconds);
+    set_text(s.time, &text[at..]);
+    redraw(s);
+    if was >> 16 == phase as u32 {
+        return;
+    }
+    let (name, colour): (&[u8], u32) = match phase {
+        Phase::Idle => (b"Set Light\0", WHITE),
+        Phase::OnStage => (b"ON STAGE\0", WHITE),
+        Phase::WrapUp => (b"WRAP UP\0", AMBER),
+        Phase::OverTime => (b"OVER TIME\0", RED),
+    };
+    set_text(s.phase, name);
+    style(s.phase, STYLE_TEXT_COLOR, colour, 0);
+    style(s.time, STYLE_TEXT_COLOR, colour, 0);
+    let idle = phase == Phase::Idle;
+    set_text(s.go, if idle { b"Start\0" } else { b"Stop\0" });
+    let show = if idle { OBJ_CLEAR_FLAG } else { OBJ_ADD_FLAG };
+    for o in [s.minus, s.plus] {
+        stock!(show, fn(Obj, u32) -> ())(o, FLAG_HIDDEN);
+    }
+}
+
+/// Starts (or extends) the burst of whole-panel redraws that follows a change.
+fn redraw(s: &mut State) {
+    s.redraws = REDRAWS;
+    if s.burst.is_null() {
+        s.burst = stock!(TIMER_CREATE, fn(Cb, u32, *mut State) -> *mut u8)(again, REDRAW_MS, s);
+    }
+}
+
+extern "C" fn again(timer: *mut u8) {
+    let s = unsafe { &mut **(timer.add(0xC) as *mut *mut State) };
+    if !s.panel.is_null() {
+        stock!(OBJ_INVALIDATE, fn(Obj) -> ())(s.panel);
+    }
+    s.redraws = s.redraws.saturating_sub(1);
+    if s.redraws == 0 || s.panel.is_null() {
+        stock!(TIMER_DEL, fn(*mut u8) -> ())(timer);
+        s.burst = null_mut();
+    }
+}
+
+fn state(e: *mut u8) -> &'static mut State {
+    let s = stock!(EVENT_GET_USER_DATA, fn(*mut u8) -> *mut State)(e);
+    unsafe { &mut *s }
+}
+
+extern "C" fn toggle(e: *mut u8) {
+    let s = state(e);
+    if s.running { stop(s) } else { start(s) }
+    draw(s);
+}
+
+extern "C" fn shorter(e: *mut u8) {
+    let s = state(e);
+    s.preset = s.preset.saturating_sub(1);
+    draw(s);
+}
+
+extern "C" fn longer(e: *mut u8) {
+    let s = state(e);
+    s.preset = (s.preset + 1).min(PRESETS.len() as u8 - 1);
+    draw(s);
+}
+
+// The panel went with its screen: the next tick frees the state unless a set is running.
+extern "C" fn closed(e: *mut u8) {
+    let s = state(e);
+    s.panel = null_mut();
+    for (open, font) in [(&mut s.small_open, &mut s.small), (&mut s.big_open, &mut s.big)] {
+        if core::mem::take(open) {
+            stock!(FONT_CLOSE, fn(*mut u32) -> ())(font.as_mut_ptr());
+        }
+    }
+}
