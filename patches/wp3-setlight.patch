+    out, so the boot path is the stock one."""
     if not hashlib.sha256(app).hexdigest().startswith(WP3_STOCK_SHA256_PREFIX):
         raise ValueError("not the stock jx402_08 1.0.1.77 app.bin (sha256 mismatch)")
     out = bytearray(app)
