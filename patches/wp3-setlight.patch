diff --git a/fw/wp3-stub/src/applist.rs b/fw/wp3-stub/src/applist.rs
new file mode 100644
index 0000000..2999f62
--- /dev/null
+++ b/fw/wp3-stub/src/applist.rs
@@ -0,0 +1,223 @@
+// "Set Light" entry in the stock app list of the Watch 3 Pro (jx402_08 1.0.1.77), in the List and in the Grid
+// style. A tap opens the set timer (setlight.rs).
+//
+// Both hooks replace a style descriptor's update handler (+0x10). The stock view procedure calls it right after
+// the layout, and the stock update rebuilds the screen through a direct call to the layout when an optional
+// entry appears or goes, so the layout slot alone would lose the entry. No writable statics: the entry is there
+// when the container has one child more than the stock entries shown.
+use crate::stock::*;
+
+// view data (`*(view + 0x14)`): the screen is the first word in both styles
+const FLAGS: usize = 0x290; // bit0 entry 11, bit1 entry 9, bit2 entry 10 are shown
+const LIST_CONT: usize = 0x4;
+const LIST_COUNT: usize = 0x8;
+const LIST_STYLE: usize = 0x264;
+const LIST_LINE_HEIGHT: usize = 0x274;
+const GRID_OBJS: usize = 0x16C;
+const GRID_CONT: usize = 0x1E4;
+const GRID_COUNT: usize = 0x1E8;
+const GRID_LOWEST: usize = 0x1F8;
+
+const ENTRIES: u8 = 30;
+const ALWAYS_SHOWN: u32 = 27;
+const LIST_ICON: usize = 96;
+const GRID_ICON: usize = 160;
+const ALIGN_TOP_LEFT: u32 = 1;
+const OUT_BOTTOM_LEFT: u32 = 0xD;
+const OUT_RIGHT_MID: u32 = 0x14;
+
+// Like the stock icons: LV_IMG_CF_TRUE_COLOR_ALPHA (RGB565 LE + alpha), a filled circle with a light glyph, behind
+// the 64-byte header the stock resource cache puts before its pixels (the emulator's GPU model reads it).
+const HEAD: usize = 64;
+const CIRCLE: u16 = 0x18C3; // the stock icons' circle on this watch
+const LIGHT: u16 = 0xF8E3; // red
+
+type Obj = *mut u8;
+
+#[repr(C)]
+struct ImgDsc {
+    header: u32,
+    size: u32,
+    data: *const u8,
+}
+
+#[repr(C)]
+struct TextRec {
+    text: *const u8,
+    zero: u32,
+}
+
+unsafe impl Sync for TextRec {}
+
+static LABEL: TextRec = TextRec { text: b"Set Light\0".as_ptr(), zero: 0 };
+
+pub extern "C" fn wp3_applist_list(view: *mut u8) {
+    stock!(LIST_UPDATE, fn(*mut u8) -> ())(view);
+    unsafe { add_row(view) };
+}
+
+pub extern "C" fn wp3_applist_grid(view: *mut u8) {
+    stock!(GRID_UPDATE, fn(*mut u8) -> ())(view);
+    unsafe { add_icon(view) };
+}
+
+/// The view data and its container when the stock layout has run and our entry is not there yet, with the
+/// number of stock entries shown.
+unsafe fn stock_state(view: *mut u8, cont: usize, count: usize) -> Option<(*mut u8, Obj, u32)> {
+    let data = unsafe { *(view.add(0x14) as *const *mut u8) };
+    if data.is_null() || unsafe { *(data as *const Obj) }.is_null() {
+        return None;
+    }
+    let cont = unsafe { *(data.add(cont) as *const Obj) };
+    if cont.is_null() || unsafe { *data.add(count) } != ENTRIES {
+        return None;
+    }
+    let shown = ALWAYS_SHOWN + (unsafe { *data.add(FLAGS) } & 7).count_ones();
+    (stock!(OBJ_GET_CHILD_CNT, fn(Obj) -> u32)(cont) == shown).then_some((data, cont, shown))
+}
+
+// A row built like the stock rows (0x10047164), shown first; the stock fisheye (0x10047008) walks every child.
+unsafe fn add_row(view: *mut u8) {
+    let Some((data, cont, shown)) = (unsafe { stock_state(view, LIST_CONT, LIST_COUNT) }) else { return };
+    let Some((block, dsc)) = icon_block(LIST_ICON) else { return };
+    let align_to = stock!(OBJ_ALIGN_TO, fn(Obj, Obj, u32, i32, i32) -> ());
+    let add_flag = stock!(OBJ_ADD_FLAG, fn(Obj, u32) -> ());
+    let set_size = stock!(OBJ_SET_SIZE, fn(Obj, i32, i32) -> ());
+    let add_cb = stock!(OBJ_ADD_EVENT_CB, fn(Obj, extern "C" fn(*mut u8), u32, *mut u8) -> *mut u8);
+    let row = stock!(OBJ_CREATE, fn(Obj) -> Obj)(cont);
+    let img = if row.is_null() { row } else { stock!(IMG_CREATE, fn(Obj) -> Obj)(row) };
+    if img.is_null() {
+        free(block);
+        return;
+    }
+    add_cb(img, freed, DELETE, block);
+    set_size(row, 0x18A, LIST_ICON as i32);
+    add_cb(row, crate::setlight::open, SHORT_CLICKED, core::ptr::null_mut());
+    stock!(OBJ_ALIGN, fn(Obj, u32, i32, i32) -> ())(row, ALIGN_TOP_LEFT, 0x10, 0x50);
+    add_flag(img, FLAG_EVENT_BUBBLE);
+    stock!(IMG_SET_SRC, fn(Obj, *const ImgDsc) -> ())(img, dsc);
+    let lab = stock!(LABEL_CREATE, fn(Obj) -> Obj)(row);
+    if !lab.is_null() {
+        set_size(lab, 0x172 - LIST_ICON as i32, unsafe { *(data.add(LIST_LINE_HEIGHT) as *const i32) });
+        stock!(OBJ_ADD_STYLE, fn(Obj, *mut u8, u32) -> ())(lab, unsafe { data.add(LIST_STYLE) }, 0);
+        stock!(LABEL_SET_LONG_MODE, fn(Obj, u32) -> ())(lab, 3);
+        stock!(LABEL_SET_STRING_DSC, fn(Obj, *const TextRec) -> ())(lab, &LABEL);
+        stock!(LABEL_SCROLL_SETUP, fn(Obj, u32, i32, u32) -> ())(lab, 0, -1, 0);
+        add_flag(lab, FLAG_EVENT_BUBBLE);
+        align_to(lab, img, OUT_RIGHT_MID, 0x18, 0);
+    }
+    let get_child = stock!(OBJ_GET_CHILD, fn(Obj, i32) -> Obj);
+    let mut prev = row;
+    for i in 0..shown as i32 {
+        let r = get_child(cont, i);
+        align_to(r, prev, OUT_BOTTOM_LEFT, 0, 8);
+        prev = r;
+    }
+    stock!(EVENT_SEND, fn(Obj, u32, *mut u8) -> u32)(cont, SCROLL, core::ptr::null_mut());
+}
+
+// One more icon after the stock ones (layout 0x10046B6C): the stock position function takes the count from the
+// container and the objects from a 30-pointer array, so the entry needs a stock entry to be hidden.
+unsafe fn add_icon(view: *mut u8) {
+    let Some((data, cont, shown)) = (unsafe { stock_state(view, GRID_CONT, GRID_COUNT) }) else { return };
+    if shown >= ENTRIES as u32 {
+        return;
+    }
+    let Some((block, dsc)) = icon_block(GRID_ICON) else { return };
+    let add_flag = stock!(OBJ_ADD_FLAG, fn(Obj, u32) -> ());
+    let add_cb = stock!(OBJ_ADD_EVENT_CB, fn(Obj, extern "C" fn(*mut u8), u32, *mut u8) -> *mut u8);
+    let img = stock!(IMG_CREATE, fn(Obj) -> Obj)(cont);
+    if img.is_null() {
+        free(block);
+        return;
+    }
+    unsafe { *(data.add(GRID_OBJS + 4 * shown as usize) as *mut Obj) = img };
+    add_cb(img, freed, DELETE, block);
+    stock!(IMG_SET_SRC, fn(Obj, *const ImgDsc) -> ())(img, dsc);
+    stock!(IMG_SET_PIVOT, fn(Obj, i32, i32) -> ())(img, GRID_ICON as i32 / 2, GRID_ICON as i32 / 2);
+    add_flag(img, FLAG_HIDDEN);
+    add_cb(img, crate::setlight::open, SHORT_CLICKED, core::ptr::null_mut());
+    add_flag(img, FLAG_CLICKABLE);
+    add_flag(img, FLAG_EVENT_BUBBLE);
+    // three icons per row, 160 px apart
+    unsafe { *(data.add(GRID_LOWEST) as *mut i32) = 480 - 160 * ((shown as i32 + 3) / 3) };
+    stock!(GRID_PLACE, fn(*mut u8) -> ())(data);
+}
+
+/// The icon in a RES block: [64 B header][size x size pixels][ImgDsc]. Freed with `free(block)`.
+fn icon_block(size: usize) -> Option<(*mut u8, *const ImgDsc)> {
+    let pixels_len = size * size * 3;
+    let total = HEAD + pixels_len + size_of::<ImgDsc>();
+    let alloc = stock!(UI_MEM_ALIGNED_ALLOC, fn(u32, u32, u32, *const u8) -> *mut u8);
+    let block = alloc(RES, 0x40, total as u32, b"wp3\0".as_ptr());
+    if block.is_null() {
+        return None;
+    }
+    let (pixels, dsc) = unsafe { (block.add(HEAD), block.add(HEAD + pixels_len) as *mut ImgDsc) };
+    unsafe {
+        let head = core::slice::from_raw_parts_mut(block as *mut u32, HEAD / 4);
+        head.fill(0);
+        (head[2], head[4], head[5], head[6], head[8]) = ((HEAD + pixels_len) as u32, size as u32, size as u32, 3, pixels as u32);
+        draw_icon(core::slice::from_raw_parts_mut(pixels, pixels_len), size);
+        dsc.write(ImgDsc { header: 5 | (size as u32) << 10 | (size as u32) << 21, size: pixels_len as u32, data: pixels });
+    }
+    // pixels written through the cached PSRAM mapping must reach PSRAM before the display reads them
+    unsafe { core::arch::asm!("dsb sy", options(nostack)) };
+    stock!(PSRAM_CACHE_FLUSH_INVALIDATE, fn(*mut u8, u32) -> i32)(block, total as u32);
+    unsafe { core::arch::asm!("dsb sy", "isb sy", options(nostack)) };
+    Some((block, dsc))
+}
+
+fn free(block: *mut u8) {
+    stock!(UI_MEM_FREE, fn(u32, *mut u8) -> ())(RES, block);
+}
+
+extern "C" fn freed(e: *mut u8) {
+    free(stock!(EVENT_GET_USER_DATA, fn(*mut u8) -> *mut u8)(e));
+}
+
+// Own artwork: the stock dark circle with a red light in the middle, antialiased; distances in 1/16 px.
+fn draw_icon(out: &mut [u8], size: usize) {
+    let (c, r) = (size as i32 * 8, size as i32 * 4);
+    for y in 0..size {
+        for x in 0..size {
+            let (px, py) = (x as i32 * 16 + 8 - c, y as i32 * 16 + 8 - c);
+            let d = isqrt(px * px + py * py);
+            let colour = mix(CIRCLE, LIGHT, cover(d - r));
+            let i = (y * size + x) * 3;
+            out[i..i + 3].copy_from_slice(&[colour as u8, (colour >> 8) as u8, (cover(d - c) * 255 / 16) as u8]);
+        }
+    }
+}
+
+// 0..=16 of a pixel covered by a shape whose edge is `d` (1/16 px, negative inside) from the pixel centre
+fn cover(d: i32) -> i32 {
+    (8 - d).clamp(0, 16)
+}
+
+fn mix(a: u16, b: u16, t: i32) -> u16 {
+    let ch = |shift: u32, mask: i32| {
+        let (ca, cb) = ((a >> shift) as i32 & mask, (b >> shift) as i32 & mask);
+        (((ca * (16 - t) + cb * t + 8) / 16) as u16) << shift
+    };
+    ch(11, 31) | ch(5, 63) | ch(0, 31)
+}
+
+fn isqrt(n: i32) -> i32 {
+    let mut x = n as u32;
+    let mut r = 0u32;
+    let mut bit = 1u32 << 30;
+    while bit > x {
+        bit >>= 2;
+    }
+    while bit != 0 {
+        if x >= r + bit {
+            x -= r + bit;
+            r = (r >> 1) + bit;
+        } else {
+            r >>= 1;
+        }
+        bit >>= 2;
+    }
+    r as i32
+}
